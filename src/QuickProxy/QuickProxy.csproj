<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
        <DockerfileFastModeStage>base</DockerfileFastModeStage>
        <DockerfileTag>dev</DockerfileTag>
        <!--<ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>-->
        <UserSecretsId>19c519fe-218a-4628-a458-4277d18c3bba</UserSecretsId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>
        <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Proxy\Api\AuthApiExtensions.cs" />
        <EmbeddedResource Include="ClientFallback\**\*">
            <LogicalName>QuickProxy.ClientFallback.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <Content Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Docker.DotNet" Version="3.125.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Packages\Aditify\Identity.AspNetCore\Aditify.Identity.AspNetCore.csproj" />
        <ProjectReference Include="..\QuickProxy.Shared\QuickProxy.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="Data\**\*">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <Import Project="Container.props" />
</Project>

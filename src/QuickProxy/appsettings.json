{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
    }
  },
  "Listen": {
    "HttpPort": 18080,
    "HttpsPort": 18443,
    "InternalPort": 9000,
    "AdminUseHttps": false,
    "AdminAccess": "localhost",
    "AdminCertificate": {
      "Path": "",
      "Password": "",
      "PasswordEnvVar": ""
    }
  },
  "Proxy": {
    "Enabled": true,
    "Storage": {
      "Provider": "sqlite",
      "ConnectionString": "Data Source=Data/quickproxy.db"
    }
  },
  "Config": {
    "Enabled": true,
    "Storage": {
      "Provider": "sqlite",
      "ConnectionString": "Data Source=Data/quickconfig.db"
    },
    "Remote": {
      "Enabled": false,
      "Url": "http://localhost:9001",
      "TimeoutSeconds": 30
    },
    "Secrets": {
      "EncryptionKey": ""
    }
  },
  "Audit": {
    "Enabled": true,
    "Storage": {
      "Provider": "sqlite",
      "ConnectionString": "Data Source=Data/quickaudit.db"
    }
  },
  "Containers": {
    "Enabled": true,
    "Endpoint": "",
    "RefreshIntervalSeconds": 15,
    "ResyncIntervalSeconds": 300,
    "InternalDns": {
      "Enabled": false,
      "BindAddress": "0.0.0.0",
      "AnswerIp": "",
      "Names": [ "*.dev.localhost", "*.dev.internal", "dev.localhost", "dev.internal" ]
    },
    "Stats": {
      "Enabled": true,
      "RefreshIntervalSeconds": 15,
      "TimeoutSeconds": 10
    },
    "ImageUpdates": {
      "Enabled": true,
      "RefreshIntervalSeconds": 300,
      "TimeoutSeconds": 20,
      "HarborUrl": "",
      "HarborRepositoryPrefix": ""
    }
  },
  "TemplateValues": {
    "Server": {
      "Name": "",
      "Ip": ""
    }
  },
  "Provisioning": {
    "Enabled": false,
    "FilePath": "",
    "Url": "http://localhost:9000/api/config/provisioning?raw",
    "TimeoutSeconds": 30
  },
  "AllowedHosts": "*"
}
